{
  "expo": {
    "name": "aplicacion-gastronomica",
    "slug": "aplicacion-gastronomica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Tg_round.png",
    "scheme": "aplicaciongastronomica",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/Tg_round.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jorge_ortega.aplicaciongastronomica",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD-9tSrke72PouQMnMX-a7eZSW0jkFh94w"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Tg_round.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Tg_round.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E8443A",
          "dark": {
            "backgroundColor": "#E8443A"
          }
        }
      ],
      "expo-asset",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Esta app necesita la cámara para el modo AR"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
